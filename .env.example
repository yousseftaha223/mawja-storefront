# Copy these names into Vercel -> Project -> Settings -> Environment Variables (Production + Preview).
# Do NOT commit real values. Do NOT put them in index.html / admin.html.

# Supabase "service_role" (or secret) key: Supabase -> Project Settings -> API Keys. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot token from @BotFather, and the chat id that should receive the orders.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional (defaults to the project URL already used by the site)
# SUPABASE_URL=https://ppqgtzujpoyhglxsykdw.supabase.co
