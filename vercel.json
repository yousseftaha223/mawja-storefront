{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/demo/:path*", "destination": "https://raw.githubusercontent.com/yousseftaha223/mawja-storefront/main/demo/:path*" },
    { "source": "/brand/:path*", "destination": "https://raw.githubusercontent.com/yousseftaha223/mawja-storefront/main/brand/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/site-data/storefront.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
